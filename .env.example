# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/parasoins
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication (use a random string of at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Google Gemini API (Backend only - NEVER expose in frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api